# SlashLoot publish credentials
#
# Copy to .env and fill in. The .env file is gitignored.
#
# Used by:
#   scripts/publish-curseforge.py
#   scripts/publish-modrinth.py

# CurseForge — get a token at https://authors-old.curseforge.com/account/api-tokens
# Token needs "Upload File" permission on the SlashLoot project.
CURSEFORGE_TOKEN=
CURSEFORGE_PROJECT_ID=1552991

# Modrinth — generate a PAT at https://modrinth.com/settings/pats
# Required scope: "Create version" (and "Read version" for the idempotency check).
MODRINTH_TOKEN=
MODRINTH_PROJECT_SLUG=slashloot
